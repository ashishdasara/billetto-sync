<% content_for :title, "Events | Billetto Sync" %>

<main class="events">
  <h1>Events</h1>

  <% if @events.load.empty? %>
    <p>No events found.</p>
  <% end %>

  <% @events.each do |event| %>
    <article class="event">
      <%= image_tag event.image_link, alt: "", loading: "lazy", class: "event-image" %>

      <div>
        <h2 class="event-title"><%= link_to event.title, event_path(event), target: '_blank' %></h2>
        <%= display_time(event) %>
        <%= display_category(event) %>
        <%= display_location(event) %>
      </div>

      <div class="event-voting">
        <% current_direction = @current_user_votes[event.id]&.direction %>
        <% vote_count_up = @vote_counts[[event.id, "up"]] || 0 %>
        <% vote_count_down = @vote_counts[[event.id, "down"]] || 0 %>

        <%= button_to "Up <i class='fa fa-thumbs-up'></i> (#{vote_count_up})".html_safe, event_votes_path(event), params: { direction: "up" },
                      aria: { pressed: current_direction == "up" }, class: "vote-button #{"up-active" if current_direction == "up"}" %>
        <%= button_to "Down <i class='fa fa-thumbs-down'></i> (#{vote_count_down})".html_safe, event_votes_path(event), params: { direction: "down" },
                      aria: { pressed: current_direction == "down" }, class: "vote-button #{"down-active" if current_direction == "down"}" %>
      </div>
    </article>
  <% end %>

  <% if @events.out_of_range? && @events.current_page > 1 %>
    <nav class="pagination" aria-label="Event pages">
      <%= link_to "Previous", url_for(page: @events.current_page - 1) %>
      <span>Page <%= @events.current_page %></span>
    </nav>
  <% elsif @events.total_pages == 1 %>
    <nav class="pagination" aria-label="Event pages">
      <span class="page current" aria-current="page">1</span>
    </nav>
  <% else %>
    <%= paginate @events %>
  <% end %>
</main>
